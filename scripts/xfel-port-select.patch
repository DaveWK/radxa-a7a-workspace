diff --git a/linux-fel-port.h b/linux-fel-port.h
new file mode 100644
index 0000000..2a4dde8
--- /dev/null
+++ b/linux-fel-port.h
@@ -0,0 +1,109 @@
+/* SPDX-License-Identifier: MIT */
+/* Linux only: select in sysfs, then attest and wrap the SAME open usbfs fd.
+ * Never ask libusb to rediscover a device by its recyclable address. */
+#include <fcntl.h>
+#include <glob.h>
+#include <limits.h>
+#include <linux/usbdevice_fs.h>
+#include <stddef.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+struct fel_identity {
+	char path[40];
+	unsigned bus, address;
+};
+
+static int attribute(const char *dir, const char *name, char value[40])
+{
+	char file[PATH_MAX], tail;
+	if(snprintf(file, sizeof(file), "%s/%s", dir, name) >= (int)sizeof(file))
+		return 0;
+	FILE *f = fopen(file, "r");
+	if(!f)
+		return 0;
+	int ok = fscanf(f, "%39s %c", value, &tail) == 1;
+	fclose(f);
+	return ok;
+}
+
+static int number(const char *text, unsigned *out, unsigned max)
+{
+	char *end;
+	unsigned long n = strtoul(text, &end, 10);
+	if(!*text || *end || strspn(text, "0123456789") != strlen(text) || n == 0 || n > max)
+		return 0;
+	*out = n;
+	return 1;
+}
+
+static int discover(const char *port, unsigned expected, struct fel_identity *found)
+{
+	glob_t paths = {0};
+	int matches = 0;
+	if(glob("/sys/bus/usb/devices/[0-9]*-*", GLOB_ERR, NULL, &paths) != 0)
+		goto done;
+	for(size_t i = 0; i < paths.gl_pathc; ++i)
+	{
+		const char *dir = paths.gl_pathv[i], *name = strrchr(dir, '/') + 1;
+		if(strchr(name, ':')) /* USB interface, not a device. */
+			continue;
+		char bus[40], chain[40], address[40], vid[40], pid[40];
+		struct fel_identity id = {0};
+		if(!attribute(dir, "busnum", bus) || !number(bus, &id.bus, 255) ||
+		   !attribute(dir, "devpath", chain) ||
+		   snprintf(id.path, sizeof(id.path), "%u-%s", id.bus, chain) >= (int)sizeof(id.path) ||
+		   strcmp(name, id.path))
+			goto refuse;
+		if(port && strcmp(port, id.path))
+			continue;
+		if(!attribute(dir, "idVendor", vid) || !attribute(dir, "idProduct", pid))
+			goto refuse;
+		if(strcmp(vid, "1f3a") || strcmp(pid, "efe8"))
+		{
+			if(port)
+				goto refuse;
+			continue;
+		}
+		if(!attribute(dir, "devnum", address) || !number(address, &id.address, 127) ||
+		   (expected && expected != id.address))
+			goto refuse;
+		*found = id;
+		++matches;
+	}
+done:
+	globfree(&paths);
+	return matches == 1;
+refuse:
+	globfree(&paths);
+	return 0;
+}
+
+static int verified_fd(const struct fel_identity *id)
+{
+	char node[40], path[40];
+	struct usbdevfs_conninfo_ex info = {0};
+	unsigned char desc[18];
+	snprintf(node, sizeof(node), "/dev/bus/usb/%03u/%03u", id->bus, id->address);
+	int fd = open(node, O_RDWR | O_CLOEXEC | O_NOFOLLOW);
+	if(fd < 0)
+		return -1;
+	if(ioctl(fd, USBDEVFS_CONNINFO_EX(sizeof(info)), &info) < 0 ||
+	   info.busnum != id->bus || info.devnum != id->address ||
+	   !info.num_ports || info.num_ports > sizeof(info.ports) ||
+	   info.size < offsetof(struct usbdevfs_conninfo_ex, ports) + info.num_ports)
+		goto refuse;
+	int used = snprintf(path, sizeof(path), "%u", info.busnum);
+	for(unsigned i = 0; i < info.num_ports; ++i)
+		used += snprintf(path + used, sizeof(path) - used, "%c%u", i ? '.' : '-', (unsigned)info.ports[i]);
+	/* usbfs read at offset 0 returns the cached device descriptor, not a
+	 * control transfer. Supported hosts are little-endian Linux. */
+	if(strcmp(path, id->path) || pread(fd, desc, sizeof(desc), 0) != sizeof(desc) ||
+	   desc[0] != sizeof(desc) || desc[1] != LIBUSB_DT_DEVICE ||
+	   desc[8] != 0x3a || desc[9] != 0x1f || desc[10] != 0xe8 || desc[11] != 0xef)
+		goto refuse;
+	return fd;
+refuse:
+	close(fd);
+	return -1;
+}

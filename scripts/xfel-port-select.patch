diff --git a/linux-fel-port.h b/linux-fel-port.h
new file mode 100644
index 0000000..42eaa87
--- /dev/null
+++ b/linux-fel-port.h
@@ -0,0 +1,137 @@
+/* SPDX-License-Identifier: MIT */
+/* Linux only: select in sysfs, then attest and wrap the SAME open usbfs fd.
+ * Never ask libusb to rediscover a device by its recyclable address. */
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <errno.h>
+#include <limits.h>
+#include <linux/usbdevice_fs.h>
+#include <stddef.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+struct fel_identity {
+	char path[40];
+	unsigned bus, address;
+};
+
+static int attribute(const char *dir, const char *name, char value[40])
+{
+	char file[PATH_MAX], tail;
+	if(snprintf(file, sizeof(file), "%s/%s", dir, name) >= (int)sizeof(file))
+		return 0;
+	FILE *f = fopen(file, "r");
+	if(!f)
+		return 0;
+	int ok = fscanf(f, "%39s %c", value, &tail) == 1;
+	fclose(f);
+	return ok;
+}
+
+static int number(const char *text, unsigned *out, unsigned max)
+{
+	char *end;
+	unsigned long n = strtoul(text, &end, 10);
+	if(!*text || *end || strspn(text, "0123456789") != strlen(text) || n == 0 || n > max)
+		return 0;
+	*out = n;
+	return 1;
+}
+
+static int valid_port(const char *port)
+{
+	char component[4];
+	unsigned value;
+	const char *next = strchr(port, '-');
+	if(!next)
+		return 0;
+	for(unsigned i = 0; ; ++i)
+	{
+		size_t len = next ? (size_t)(next - port) : strlen(port);
+		if(!len || len >= sizeof(component) || *port == '0' || i > 7)
+			return 0;
+		memcpy(component, port, len);
+		component[len] = '\0';
+		if(!number(component, &value, 255))
+			return 0;
+		if(!next)
+			return 1;
+		port = next + 1;
+		next = strchr(port, '.');
+	}
+}
+
+/* Only inspect the requested connector; peer activity is not admission input. */
+static int discover(const char *port, unsigned expected, struct fel_identity *id)
+{
+	char dir[PATH_MAX], bus[40], chain[40], address[40], vid[40], pid[40];
+	struct stat st;
+	if(!valid_port(port))
+		return 2;
+	if(stat("/sys/bus/usb/devices", &st) < 0 || !S_ISDIR(st.st_mode))
+		return 125;
+	snprintf(dir, sizeof(dir), "/sys/bus/usb/devices/%s", port);
+	if(stat(dir, &st) < 0)
+		return errno == ENOENT || errno == ENODEV ? 66 : 125;
+	if(!attribute(dir, "busnum", bus) || !number(bus, &id->bus, 255) ||
+	   !attribute(dir, "devpath", chain) ||
+	   snprintf(id->path, sizeof(id->path), "%u-%s", id->bus, chain) >= (int)sizeof(id->path) ||
+	   !attribute(dir, "idVendor", vid) || !attribute(dir, "idProduct", pid) ||
+	   !attribute(dir, "devnum", address) || !number(address, &id->address, 127))
+	{
+		if(stat(dir, &st) < 0 && (errno == ENOENT || errno == ENODEV))
+			return 66;
+		return 125;
+	}
+	if(strcmp(port, id->path) || strcmp(vid, "1f3a") || strcmp(pid, "efe8") || id->address != expected)
+		return 125;
+	return 0;
+}
+
+static int verified_fd(const struct fel_identity *id, int *status)
+{
+	char node[40], path[40];
+	struct usbdevfs_conninfo_ex info = {0};
+	unsigned char desc[18];
+	snprintf(node, sizeof(node), "/dev/bus/usb/%03u/%03u", id->bus, id->address);
+	int fd = open(node, O_RDWR | O_CLOEXEC | O_NOFOLLOW);
+	*status = 125;
+	if(fd < 0)
+	{
+		if(errno == ENODEV || errno == ESHUTDOWN)
+			*status = 66;
+		else if(errno == ENOENT)
+		{
+			struct fel_identity check;
+			if(discover(id->path, id->address, &check) == 66)
+				*status = 66;
+		}
+		return -1;
+	}
+	if(ioctl(fd, USBDEVFS_CONNINFO_EX(sizeof(info)), &info) < 0)
+		goto io_error;
+	if(info.busnum != id->bus || info.devnum != id->address ||
+	   !info.num_ports || info.num_ports > sizeof(info.ports) ||
+	   info.size < offsetof(struct usbdevfs_conninfo_ex, ports) + info.num_ports)
+		goto refuse;
+	int used = snprintf(path, sizeof(path), "%u", info.busnum);
+	for(unsigned i = 0; i < info.num_ports; ++i)
+		used += snprintf(path + used, sizeof(path) - used, "%c%u", i ? '.' : '-', (unsigned)info.ports[i]);
+	/* usbfs read at offset 0 returns the cached device descriptor, not a
+	 * control transfer. Supported hosts are little-endian Linux. */
+	if(strcmp(path, id->path))
+		goto refuse;
+	ssize_t n = pread(fd, desc, sizeof(desc), 0);
+	if(n < 0)
+		goto io_error;
+	if(n != sizeof(desc) || desc[0] != sizeof(desc) || desc[1] != LIBUSB_DT_DEVICE ||
+	   desc[8] != 0x3a || desc[9] != 0x1f || desc[10] != 0xe8 || desc[11] != 0xef)
+		goto refuse;
+	return fd;
+io_error:
+	if(errno == ENODEV || errno == ESHUTDOWN)
+		*status = 66;
+refuse:
+	close(fd);
+	return -1;
+}

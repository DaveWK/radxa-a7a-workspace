#!/usr/bin/python3 -I
# SPDX-License-Identifier: GPL-2.0-only
"""Stateless A733 FEL selector, pinned to a port and current devnum."""

import argparse
import errno
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
import tempfile

SCRIPTS = Path(__file__).resolve().parent
PORT = re.compile(r"[1-9][0-9]*-[1-9][0-9]*(?:\.[1-9][0-9]*)*")
DECIMAL = re.compile(r"[0-9]+")


def number(text, max_value):
    if not DECIMAL.fullmatch(text) or not 1 <= int(text) <= max_value:
        raise ValueError(f"invalid USB number: {text!r}")
    return int(text)


def discover(root, port):
    root.stat()  # A missing/unreadable sysfs root is not device loss.
    path = root / port
    try:
        fields = [
            (path / name).read_text().strip()
            for name in ("idVendor", "idProduct", "busnum", "devpath", "devnum")
        ]
    except OSError as exc:
        if exc.errno not in (errno.ENOENT, errno.ENODEV):
            raise
        root.stat()
        path.stat()  # Only classify the whole missing connector as absent.
        raise ValueError(f"incomplete USB identity at {port}") from exc
    vid, pid, bus, chain, devnum = fields
    if (vid, pid) != ("1f3a", "efe8") or f"{number(bus, 255)}-{chain}" != port:
        raise ValueError(f"wrong USB identity at {port}")
    return number(devnum, 127)


def main():
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
    parser.add_argument("--discover", action="store_true")
    parser.add_argument("--port", required=True)
    parser.add_argument("--devnum")
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    opts = sys.argv[1 : sys.argv.index("--")] if "--" in sys.argv else sys.argv[1:]
    for key in ("--port", "--devnum", "--discover"):
        if sum(x.split("=", 1)[0] == key for x in opts) > 1:
            parser.error(f"duplicate {key}")
    if len(args.port) >= 40 or not PORT.fullmatch(args.port):
        parser.error("expected a sysfs port such as 3-3.4")
    if args.discover:
        if args.devnum is not None or args.command:
            parser.error("--discover takes only --port PATH")
    else:
        try:
            expected = number(args.devnum or "", 127)
        except ValueError as exc:
            parser.error(str(exc))
        if (
            len(args.command) < 2
            or args.command[0] != "--"
            or args.command[1].startswith("-")
        ):
            parser.error("expected -- COMMAND [ARG ...]")
    root = Path(os.getenv("FEL_SYSFS_ROOT", "/sys/bus/usb/devices"))
    try:
        current = discover(root, args.port)
    except OSError as exc:
        if exc.filename == str(root / args.port) and exc.errno in (
            errno.ENOENT,
            errno.ENODEV,
        ):
            print(f"xfel-port: no device at {args.port}", file=sys.stderr)
            return 66
        raise
    if args.discover:
        print(current)
        return 0
    if current != expected:
        raise ValueError(
            f"devnum changed at {args.port}: expected {expected}, found {current}"
        )

    out = SCRIPTS.parent / "out"
    out.mkdir(exist_ok=True)
    with tempfile.TemporaryDirectory(dir=out) as tmp:
        tool = Path(tmp) / "xfel"
        override = os.getenv("XFEL")
        subprocess.run(
            [
                sys.executable,
                "-I",
                SCRIPTS / "fel-tools.py",
                "stage-xfel",
                *(
                    ["--override", override]
                    if override is not None
                    else [out / "tools/xfel"]
                ),
                tool,
            ],
            stdout=subprocess.DEVNULL,
            check=True,
        )
        help_text = subprocess.check_output([tool, "--help"])
        if b"xfel --port PATH --devnum N COMMAND" not in help_text:
            raise ValueError(
                "xfel lacks the mandatory selector; rebuild with make xfel"
            )
        prefix = shlex.split(os.getenv("SUDO", "sudo"))
        status = subprocess.run(
            [
                *prefix,
                tool,
                "--port",
                args.port,
                "--devnum",
                str(expected),
                *args.command[1:],
            ]
        ).returncode
        return 128 - status if status < 0 else status


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        print(f"xfel-port: refused: {exc}", file=sys.stderr)
        sys.exit(125)

#!/usr/bin/python3 -I
# SPDX-License-Identifier: GPL-2.0-only
"""Stateless A733 FEL selector, pinned to a port and current devnum."""

import argparse
import errno
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

SCRIPTS = Path(__file__).resolve().parent
PORT = re.compile(r"[1-9][0-9]*-[1-9][0-9]*(?:\.[1-9][0-9]*)*")
DECIMAL = re.compile(r"[0-9]+")
ARITY = {"version": 0, "read": 3, "write": 2, "read32": 1, "write32": 2, "exec": 1}
WORD_LIMIT = 1 << 32


def number(text, max_value):
    if not DECIMAL.fullmatch(text) or not 1 <= int(text) <= max_value:
        raise ValueError(f"invalid USB number: {text!r}")
    return int(text)


def word(text):
    # Keep in sync with the raw selector's word(): ASCII uint32, explicit
    # binary/hex prefixes, leading-zero octal, otherwise decimal.
    if text[:2].lower() in ("0b", "0x"):
        base, digits = (
            (2, r"[01]+") if text[1].lower() == "b" else (16, r"[0-9a-fA-F]+")
        )
        text = text[2:]
    elif text.startswith("0"):
        base, digits = 8, r"[0-7]+"
    else:
        base, digits = 10, r"[0-9]+"
    if not re.fullmatch(digits, text) or len(text.lstrip("0")) > 32:
        raise ValueError("expected an unsigned 32-bit number")
    value = int(text, base)
    if value >= WORD_LIMIT:
        raise ValueError("expected an unsigned 32-bit number")
    return value


def validate_command(command, operands):
    if command not in ARITY or len(operands) != ARITY[command]:
        raise ValueError(f"unsupported command or wrong argument count: {command}")
    if any(arg.split("=", 1)[0] in ("--port", "--devnum") for arg in operands):
        raise ValueError("selector options must precede the command")
    if command == "version":
        return
    address = word(operands[0])
    if command in ("read", "write32"):
        value = word(operands[1])
        if command == "read" and (not value or address + value > WORD_LIMIT):
            raise ValueError("read length must be nonzero and fit the address window")


def discover(root, port):
    root.stat()  # A missing/unreadable sysfs root is not device loss.
    path = root / port
    try:
        fields = [
            (path / name).read_text().strip()
            for name in ("idVendor", "idProduct", "busnum", "devpath", "devnum")
        ]
    except OSError as exc:
        if exc.errno not in (errno.ENOENT, errno.ENODEV):
            raise
        root.stat()
        path.stat()  # Only classify the whole missing connector as absent.
        raise ValueError(f"incomplete USB identity at {port}") from exc
    vid, pid, bus, chain, devnum = fields
    if (vid, pid) != ("1f3a", "efe8") or f"{number(bus, 255)}-{chain}" != port:
        raise ValueError(f"wrong USB identity at {port}")
    return number(devnum, 127)


def write_stdout(text):
    if sys.stdout is None:
        return 74
    try:
        if sys.stdout.write(text) != len(text):
            os._exit(74)
        sys.stdout.flush()
    except OSError:
        # Do not retry the failed flush during Python interpreter shutdown.
        os._exit(74)
    return 0


def main():
    parser = argparse.ArgumentParser(
        description=__doc__,
        allow_abbrev=False,
        add_help=False,
        epilog="-h/--help must be used on its own.",
    )
    parser.add_argument("--discover", action="store_true")
    parser.add_argument("--port", required=True)
    parser.add_argument("--devnum")
    parser.add_argument("command", nargs=argparse.REMAINDER)
    argv = sys.argv[1:]
    if argv in (["-h"], ["--help"]):
        return write_stdout(parser.format_help())
    if any(arg in ("-h", "--help") for arg in argv):
        parser.error("help must be requested on its own")
    args = parser.parse_args()
    opts = sys.argv[1 : sys.argv.index("--")] if "--" in sys.argv else sys.argv[1:]
    for key in ("--port", "--devnum", "--discover"):
        if sum(x.split("=", 1)[0] == key for x in opts) > 1:
            parser.error(f"duplicate {key}")
    parts = re.split(r"[-.]", args.port)
    if (
        not PORT.fullmatch(args.port)
        or len(parts) > 8
        or any(len(part) > 3 or int(part) > 255 for part in parts)
    ):
        parser.error("expected a sysfs port such as 3-3.4")
    if args.discover:
        if args.devnum is not None or args.command:
            parser.error("--discover takes only --port PATH")
    else:
        try:
            expected = number(args.devnum or "", 127)
        except ValueError as exc:
            parser.error(str(exc))
        if (
            len(args.command) < 2
            or args.command[0] != "--"
            or args.command[1].startswith("-")
        ):
            parser.error("expected -- COMMAND [ARG ...]")
        try:
            validate_command(args.command[1], args.command[2:])
        except ValueError as exc:
            parser.error(str(exc))
        if {"SUDO", "XFEL", "EXPECT_XFEL_SHA256"} & os.environ.keys():
            raise ValueError(
                "the built selector runs directly; overrides are forbidden"
            )
    root = Path(os.getenv("FEL_SYSFS_ROOT", "/sys/bus/usb/devices"))
    try:
        current = discover(root, args.port)
    except OSError as exc:
        if exc.filename == str(root / args.port) and exc.errno in (
            errno.ENOENT,
            errno.ENODEV,
        ):
            print(f"xfel-port: no device at {args.port}", file=sys.stderr)
            return 66
        raise
    if args.discover:
        return write_stdout(f"{current}\n")
    if current != expected:
        raise ValueError(
            f"devnum changed at {args.port}: expected {expected}, found {current}"
        )

    out = SCRIPTS.parent / "out"
    out.mkdir(exist_ok=True)
    with tempfile.TemporaryDirectory(dir=out) as tmp:
        tool = Path(tmp) / "xfel"
        subprocess.run(
            [
                sys.executable,
                "-I",
                SCRIPTS / "fel-tools.py",
                "stage-xfel",
                tool,
            ],
            stdout=subprocess.DEVNULL,
            check=True,
        )
        status = subprocess.run(
            [
                tool,
                "--port",
                args.port,
                "--devnum",
                str(expected),
                *args.command[1:],
            ]
        ).returncode
        return 128 - status if status < 0 else status


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        print(f"xfel-port: refused: {exc}", file=sys.stderr)
        sys.exit(125)
